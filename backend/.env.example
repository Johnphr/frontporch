# Copy to backend/.env and fill in what you have. Everything is optional:
# GET /api/health shows which integrations are configured.

# Public URL of this backend (your ngrok / cloudflared tunnel). Twilio calls it.
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
FRONTEND_URL=http://localhost:5173

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Cartesia (Pip's voice) ---
CARTESIA_API_KEY=
# Pick a voice in the Cartesia playground and paste its id here
CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
CARTESIA_MODEL=sonic-3.6

# --- Twilio (phone calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15555550100
# Keep true. Set false only for local curl testing.
TWILIO_VALIDATE_SIGNATURE=true

# --- Convex (database) ---
# From `npx convex dev` (frontend/.env.local -> VITE_CONVEX_URL)
CONVEX_URL=https://your-deployment.convex.cloud
# Any long random string; set the SAME value in Convex:
#   cd frontend && npx convex env set BACKEND_SECRET <value>
CONVEX_BACKEND_SECRET=

# --- Apify (finding questions) ---
APIFY_TOKEN=
QUESTION_SOURCES_FILE=question_sources.json

# --- Publishing ---
# Where an answer goes when the elder says "yes" on the call
DEFAULT_PLATFORMS=feed,bluesky

BLUESKY_HANDLE=frontporch.bsky.social
# Settings -> Privacy and security -> App passwords (never your real password)
BLUESKY_APP_PASSWORD=

# Member token with w_member_social (LinkedIn developer portal token generator)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXX
LINKEDIN_VERSION=202606

# Reddit: drafts only unless you have an approved API app (see README)
REDDIT_POSTING_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Discourse forum (optional)
DISCOURSE_URL=
DISCOURSE_API_KEY=
DISCOURSE_USERNAME=

MAX_FOLLOW_UPS=2
