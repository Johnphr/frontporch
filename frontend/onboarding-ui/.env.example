# Convex deployment URL (Convex dashboard -> Settings -> URL, or printed by `npx convex dev`).
# Must be the deployment that has convex/signup.ts (feat/characters) deployed.
VITE_CONVEX_URL=

# Optional: the number people can call to talk to their host (E.164, e.g. +14155550123).
# Shown on the Home tab and the last setup screen; hidden when unset.
VITE_PORCH_NUMBER=
